<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_controller_py</name>
  <version>1.4.0</version>
  <description>
    Python port of the Nav2 controller server (nav2_controller).
    Provides a ROS2 lifecycle node that loads Python controller, goal checker,
    progress checker and path handler plugins via the nav2_core_py plugin
    provider, mirroring the C++ pluginlib mechanism.
  </description>

  <maintainer email="ajtudela@gmail.com">Alberto Tudela</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>bondpy</exec_depend>
  <exec_depend>nav2_core_py</exec_depend>
  <exec_depend>nav2_costmap_2d_py</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <nav2_controller_py plugin="${prefix}/plugins.xml"/>
  </export>
</package>
